# ─────────────────────────────────────────────────────────────
# Mealfy Backend — variáveis de ambiente (copie para .env)
# ─────────────────────────────────────────────────────────────

# Núcleo da API
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Banco de dados (Fase 1B em diante) — PostgreSQL (Supabase/Railway/Render/local)
# Ex.: postgresql://user:password@host:5432/mealfy?schema=public
DATABASE_URL=

# Autenticação (Fase 2) — ainda não usados na fundação
JWT_SECRET=
ENCRYPTION_KEY=

# Pagamentos (Fase 5)
#  mock   → Pix fictício (dev/staging), não movimenta dinheiro real
#  stripe → Pix e cartão reais; cartão é o caminho do Google Pay / Apple Pay
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
PIX_EXPIRATION_MINUTES=30

# Stripe — OBRIGATÓRIOS quando PAYMENT_PROVIDER=stripe (o boot falha sem eles).
#  1. Dashboard do Stripe → Developers → API keys → Secret key (sk_test_... / sk_live_...)
#  2. Developers → Webhooks → criar endpoint POST {API}/payments/webhook
#     Eventos: payment_intent.succeeded, payment_intent.payment_failed,
#              payment_intent.canceled, charge.refunded
#     Copiar o "Signing secret" (whsec_...) para STRIPE_WEBHOOK_SECRET
#  3. Google Pay: habilitar em Settings → Payment methods (o Stripe é o gateway
#     que recebe o cartão tokenizado da carteira; não há chave extra do Google)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gift card provider (Fase 7) — só manual_inventory implementado.
# Demais valores (todo_incomm/incentive_me/ding_connect/ifood_card/stub) são
# pendência comercial — fornecedor real ainda não escolhido.
GIFT_CARD_PROVIDER=manual_inventory

# E-mail (Fase 6) — mock no MVP
EMAIL_PROVIDER=mock
EMAIL_API_KEY=

# URLs públicas (deploy)
APP_URL=
ADMIN_URL=

# ─────────────────────────────────────────────────────────────
# Login social (Fase 8) — cada provedor só liga quando suas credenciais existem.
# Sem credenciais, o endpoint responde 501 provider_not_configured (não quebra o boot).
# ─────────────────────────────────────────────────────────────
# Papel padrão de quem se cadastra via login social (donor | entity)
OAUTH_DEFAULT_ROLE=donor

# Google — Google Cloud Console → Credenciais → Client ID Web (usado como `aud`)
GOOGLE_CLIENT_ID=

# Facebook/Meta — Meta for Developers → App → Configurações
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple — Services ID configurado no Apple Developer (client_id / `aud`)
APPLE_CLIENT_ID=

# Gov.br — credenciais obtidas no portal (exige CNPJ). staging antes de production.
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=
GOVBR_ENV=staging
